// 감각 (교범 05쪽 '상황판 전구와 청음기 진공관'). panel.crossed, gauge.voltage, searchlight.weak는 WP20(2차 고장).
{
  "pairs": {
    "panel.crossed": {
      "no": 16,
      "priority": 8,
      "page": "05-진단-표-공기-감각-항법-케이블.md",
      "section": "상황판 전구와 청음기 진공관",
      "sees": [
        [ { "q": "panel.on", "unit": "none", "above": 0.5 },
          { "q": "panel.lamp.hull", "not": "off", "says": "선체 표시등이 켜졌는데 구역 경고등은 모두 꺼져 있다" },
          { "q": "zone.fore.alarm", "unit": "none", "below": 0.5 }, { "q": "zone.mid.alarm", "unit": "none", "below": 0.5 }, { "q": "zone.aft.alarm", "unit": "none", "below": 0.5 } ]
      ],
      "checks": [
        {
          "all": [ { "q": "cue.panel.wiring.dew", "unit": "cue", "above": 0.3, "says": "배선함에 이슬" }, { "lamptest": "water", "unit": "none", "above": 0.5, "says": "램프 시험은 여덟 전구가 모두 켜진다" } ],
          "verdict": "SNS-02"
        }
      ],
      "verdicts": {
        "SNS-02": {
          "fault": "SNS-02",
          "says": "상황판 배선 오표시",
          "do": [ { "procedure": "proc.panelwiring.dry" } ],
          "verify": { "all": [ { "q": "cue.panel.wiring.dew", "unit": "cue", "below": 0.1 }, { "q": "panel.lamp.hull", "is": "off" } ], "within": 10, "hold": 5 }
        }
      },
      "exposure": { "setup": { "depthM": 300, "bilges": { "bilge.aft": 150 } }, "seconds": 5 },
      "cases": [
        { "expect": "SNS-02", "inject": [ { "fault": "SNS-02", "part": "panel.wiring" } ] },
        { "expect": "none", "inject": [ { "fault": "SNS-01", "part": "panel.bulb.water" } ] },
        { "expect": "none" }
      ]
    },
    "gauge.voltage": {
      "no": 17,
      "priority": 45,
      "page": "05-진단-표-공기-감각-항법-케이블.md",
      "section": "상황판 전구와 청음기 진공관",
      "sees": [
        [ { "q": "panel.gauge.voltage", "unit": "V", "below": 105, "for": 10, "says": "전압 바늘이 낮은데" },
          { "q": "panel.lamp.power", "is": "off", "says": "동력 표시등이 꺼져 있다" } ]
      ],
      "checks": [
        {

          "undo": [ { "cmd": "tool.hand" } ],
          "all": [ { "q": "panel.gauge.voltage", "unit": "V", "below": 105, "typical": 102 }, { "measure": "voltmeter", "target": "bus", "unit": "V", "above": 110, "typical": 120, "says": "손에 든 전압계로 버스 바를 잰다" } ],
          "verdict": "SNS-05"
        }
      ],
      "verdicts": {
        "SNS-05": {
          "fault": "SNS-05",
          "says": "상황판 계기 영점 보정",
          "do": [ { "procedure": "proc.gauge.zero", "bind": { "gauge": "voltage" } } ],
          "verify": { "all": [ { "q": "panel.gauge.voltage", "unit": "V", "above": 115 } ], "within": 10, "hold": 5 }
        }
      },
      "exposure": { "setup": { "depthM": 300 }, "seconds": 15 },
      "cases": [
        { "expect": "SNS-05", "inject": [ { "fault": "SNS-05", "part": "gauge.voltage" } ] },
        { "expect": "none", "inject": [ { "fault": "PWR-01", "part": "cell.3" } ] },
        { "expect": "none" }
      ]
    },
    "searchlight.weak": {
      "no": 18,
      "priority": 55,
      "page": "05-진단-표-공기-감각-항법-케이블.md",
      "section": "상황판 전구와 청음기 진공관",
      "sees": [
        [ { "q": "cue.searchlight.sputter", "unit": "cue", "above": 0.2, "says": "누렇게 흔들리고 지직거린다" } ],
        [ { "q": "panel.lamp.senses", "not": "off" }, { "q": "cue.searchlight.arc", "unit": "cue", "below": 0.5, "says": "탐조등을 켜 두었는데 불빛과 소리가 없다" },

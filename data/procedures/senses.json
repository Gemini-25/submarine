{
  "proc.bulb.replace": {
    "title": "상황판 전구 교체",
    "fault": "SNS-01",
    "grade": "proper",
    "bind": [ "lamp" ],
    "steps": [
      { "type": "Inspect", "text": "램프 시험 단추를 누르고 있는 동안 여덟 표시등이 모두 켜지는지 본다. 켜지지 않는 표시등의 전구가 탄 것이다." },
      { "type": "Open", "text": "그 표시등의 테를 손으로 반시계로 돌려 푼다.", "cmd": "panel.bezel.{lamp}.loosen", "tool": "hand" },
      { "type": "Remove", "text": "탄 전구를 뽑는다. 유리가 검게 그을려 있다.", "cmd": "panel.bulb.{lamp}.pull", "tool": "hand", "requires": "테를 풀었을 것", "hazard": "테가 덮고 있으면 전구가 빠지지 않는다." },
      { "type": "Remove", "text": "탄 전구를 폐기함에 버린다.", "cmd": "hand.drop" },
      { "type": "Install", "text": "예비품 사물함에서 상황판 전구를 꺼낸다.", "cmd": "locker.take.panel_bulb" },
      { "type": "Install", "text": "새 전구를 소켓에 끝까지 밀어 넣는다.", "cmd": "panel.bulb.{lamp}.insert" },
      { "type": "Fasten", "text": "테를 손으로 시계 방향으로 끝까지 돌려 조인다.", "cmd": "panel.bezel.{lamp}.tighten", "tool": "hand", "requires": "끝까지 조일 것", "hazard": "테가 헐거우면 전구가 깜박인다." },
      { "type": "Test", "text": "램프 시험 단추를 눌러 여덟 표시등이 모두 고르게 켜지는지 본다." }
    ]
  },
  "proc.tube.replace": {
    "title": "청음기 진공관 교체",
    "fault": "SNS-03",
    "grade": "proper",
    "bind": [ "tube" ],
    "steps": [
      { "type": "Inspect", "text": "청음기 문 유리 너머로 두 진공관의 필라멘트를 본다. 불빛이 흐리거나 꺼진 관이 탄 것이다." },
      { "type": "Isolate", "text": "청음기를 끈다.", "cmd": "device.hydrophone.off" },
      { "type": "Inspect", "text": "청음기 몸체를 맨손으로 만져 본다. 따뜻한 정도로 식을 때까지 기다린다.", "cmd": "hydrophone.touch", "tool": "hand" },
      { "type": "Open", "text": "드라이버로 문 나사 두 개를 반시계로 돌려 푼다.", "cmd": "hydrophone.door.screw.{n}.loosen", "tool": "screwdriver", "repeat": 2 },
      { "type": "Open", "text": "문을 연다.", "cmd": "hydrophone.door.open", "tool": "hand" },
      { "type": "Remove", "text": "탄 진공관을 소켓에서 곧게 뽑는다.", "cmd": "hydrophone.tube.{tube}.pull", "tool": "hand", "requires": "청음기를 끄고 몸체가 식었을 것", "hazard": "켠 채로 뽑으면 감전된다. 뜨거울 때 뽑으면 손을 덴다." },
      { "type": "Remove", "text": "탄 진공관을 폐기함에 버린다.", "cmd": "hand.drop" },
      { "type": "Install", "text": "예비품 사물함에서 6호 진공관을 꺼낸다.", "cmd": "locker.take.vacuum_tube" },
      { "type": "Install", "text": "새 진공관의 핀을 소켓 구멍에 맞추어 끝까지 꽂는다.", "cmd": "hydrophone.tube.{tube}.insert", "requires": "청음기가 꺼져 있을 것", "hazard": "켠 채로 꽂으면 감전된다." },
      { "type": "Close", "text": "문을 닫는다.", "cmd": "hydrophone.door.close", "tool": "hand" },
      { "type": "Fasten", "text": "드라이버로 문 나사 두 개를 시계 방향으로 조인다.", "cmd": "hydrophone.door.screw.{n}.tighten", "tool": "screwdriver", "repeat": 2 },
      { "type": "Test", "text": "청음기를 켠다. 두 필라멘트가 함께 빛나는지 보고, 헤드폰의 잡음이 가라앉았는지 듣는다.", "cmd": "device.hydrophone.on" }
    ]
  },
  "proc.tube.salvage": {
    "title": "소나 진공관 빼 쓰기",
    "fault": "SNS-03",
    "grade": "proper",
    "bind": [ "tube" ],
    "steps": [
      { "type": "Inspect", "text": "사물함의 6호 진공관 칸이 비었는지 확인한다. 소나의 진공관은 청음기의 것과 같은 6호 관이다." },
      { "type": "Isolate", "text": "청음기를 끈다.", "cmd": "device.hydrophone.off" },
      { "type": "Inspect", "text": "청음기 몸체를 맨손으로 만져 본다. 따뜻한 정도로 식을 때까지 기다린다.", "cmd": "hydrophone.touch", "tool": "hand" },
      { "type": "Open", "text": "드라이버로 문 나사 두 개를 반시계로 돌려 푼다.", "cmd": "hydrophone.door.screw.{n}.loosen", "tool": "screwdriver", "repeat": 2 },
      { "type": "Open", "text": "문을 연다.", "cmd": "hydrophone.door.open", "tool": "hand" },
      { "type": "Remove", "text": "탄 진공관을 소켓에서 곧게 뽑는다.", "cmd": "hydrophone.tube.{tube}.pull", "tool": "hand", "requires": "청음기를 끄고 몸체가 식었을 것", "hazard": "켠 채로 뽑으면 감전된다. 뜨거울 때 뽑으면 손을 덴다." },
      { "type": "Remove", "text": "탄 진공관을 폐기함에 버린다.", "cmd": "hand.drop" },
      { "type": "Remove", "text": "소나 진공관을 뽑는다. 이때부터 소나는 발신하지 못한다.", "cmd": "sonarset.tube.1.pull", "tool": "hand", "requires": "소나가 발신하고 있지 않을 것", "hazard": "소나가 발신하는 동안 뽑으면 감전된다." },
      { "type": "Install", "text": "뽑은 소나 진공관을 청음기 소켓에 끝까지 꽂는다.", "cmd": "hydrophone.tube.{tube}.insert", "requires": "청음기가 꺼져 있을 것", "hazard": "켠 채로 꽂으면 감전된다." },
      { "type": "Close", "text": "문을 닫는다.", "cmd": "hydrophone.door.close", "tool": "hand" },
      { "type": "Fasten", "text": "드라이버로 문 나사 두 개를 시계 방향으로 조인다.", "cmd": "hydrophone.door.screw.{n}.tighten", "tool": "screwdriver", "repeat": 2 },
      { "type": "Test", "text": "청음기를 켠다. 두 필라멘트가 함께 빛나는지 보고, 헤드폰의 잡음이 가라앉았는지 듣는다.", "cmd": "device.hydrophone.on" }
    ]
  },
  "proc.panelwiring.dry": {
    "title": "상황판 배선함 건조와 단자 재고정",
    "fault": "SNS-02",
    "grade": "proper",
    "steps": [
      { "type": "Inspect", "text": "선체 표시등과 배수 표시등을 구역 경고등과 빌지 유리관에 견주어 본다. 구역 경고등이 모두 꺼져 있는데 선체 표시등이 켜져 있거나, 유리관의 물이 느는데 배수 표시등이 꺼져 있으면 두 표시등의 선이 엇갈린 것이다." },
      { "type": "Isolate", "text": "배전반의 C4 스위치를 내린다. 상황판이 꺼진다.", "cmd": "switch.C4.off", "tool": "hand", "hazard": "C4가 살아 있는 채 젖은 배선함을 열거나 단자판을 만지면 감전된다." },
      { "type": "Open", "text": "드라이버로 배선함 덮개 나사 네 개를 푼다.", "cmd": "panel.wiring.screw.{n}.loosen", "tool": "screwdriver", "repeat": 4 },
      { "type": "Open", "text": "덮개를 연다.", "cmd": "panel.wiring.cover.open", "tool": "hand", "requires": "C4 스위치가 내려가 있을 것", "hazard": "감전" },
      { "type": "Work", "text": "걸레로 단자판을 네 번 닦아 말린다. 선내 공기가 축축하면 네 번 닦아도 다 마르지 않는다.", "cmd": "panel.wiring.strip.dry", "tool": "rag", "repeat": 4, "requires": "C4 스위치가 내려가 있을 것", "hazard": "감전" },
      { "type": "Work", "text": "드라이버로 단자 나사를 두 번 돌려 단자를 제자리에 눌러 고정한다.", "cmd": "panel.wiring.terminals.reseat", "tool": "screwdriver", "repeat": 2, "requires": "C4 스위치가 내려가 있을 것", "hazard": "단자를 고정하지 않으면 말려도 선내 습도가 오를 때 다시 엇갈린다." },
      { "type": "Close", "text": "덮개를 닫는다.", "cmd": "panel.wiring.cover.close", "tool": "hand" },
      { "type": "Fasten", "text": "드라이버로 덮개 나사 네 개를 조인다.", "cmd": "panel.wiring.screw.{n}.tighten", "tool": "screwdriver", "repeat": 4, "hazard": "나사가 풀려 있으면 습기가 두 배로 빨리 찬다." },
      { "type": "Test", "text": "C4 스위치를 올린다. 램프 시험으로 여덟 전구가 켜지는지 보고, 선체·배수 표시등을 구역 경고등과 빌지 유리관에 다시 견주어 본다.", "cmd": "switch.C4.on", "tool": "hand" }
    ]
  },
  "proc.arc.feed": {
    "title": "탄소봉 간격 재조정",
    "fault": "SNS-04",
    "grade": "temporary",
    "steps": [
      { "type": "Inspect", "text": "현창 너머의 불빛이 누렇게 흔들리는지, 탐조등 몸통에서 지직거리는 소리가 나는지 본다. 전압이 정상인데 그렇다면 탄소봉 간격이 벌어진 것이다." },
      { "type": "Work", "text": "탄소봉 보내기 손잡이를 손으로 네 번 돌린다. 한 번에 간격이 한 눈금 좁아진다.", "cmd": "searchlight.feed.turn", "tool": "hand", "repeat": 4, "hazard": "봉이 다 타면 다시 꺼진다. 응급 수리이므로 탄소봉을 갈 것." },
      { "type": "Test", "text": "불빛이 하얗고 고르게 되었는지 본다." }
    ]
  },
  "proc.arc.rods": {
    "title": "탐조등 탄소봉 교체",
    "fault": "SNS-04",
    "grade": "proper",
    "steps": [
      { "type": "Isolate", "text": "끝벽의 탐조등 레버를 내려 탐조등을 끈다.", "cmd": "device.searchlight.off" },
      { "type": "Inspect", "text": "2분 넘게 기다린 뒤 탐조등 몸통을 맨손으로 살짝 만져 본다. 따뜻한 정도로 식을 때까지 기다린다.", "cmd": "searchlight.housing.touch", "tool": "hand" },
      { "type": "Open", "text": "장전 문 걸쇠 두 개를 젖힌다.", "cmd": "searchlight.latch.{n}.loosen", "tool": "hand", "repeat": 2, "requires": "몸통이 60°C 아래로 식었을 것", "hazard": "뜨거울 때 걸쇠와 문을 만지면 손을 덴다." },
      { "type": "Open", "text": "장전 문을 아래로 연다.", "cmd": "searchlight.door.open", "tool": "hand", "requires": "몸통이 식었을 것", "hazard": "화상" },
      { "type": "Remove", "text": "타고 남은 탄소봉 한 쌍을 뽑는다.", "cmd": "searchlight.rods.pull", "tool": "hand", "hazard": "화상" },
      { "type": "Remove", "text": "타고 남은 봉을 폐기함에 버린다.", "cmd": "hand.drop" },
      { "type": "Install", "text": "예비품 벽장에서 탄소봉 한 쌍을 꺼낸다.", "cmd": "locker.take.carbon_rods" },
      { "type": "Install", "text": "새 탄소봉을 집게에 끝까지 꽂는다.", "cmd": "searchlight.rods.insert" },
      { "type": "Work", "text": "보내기 손잡이를 다섯 번 돌려 봉 끝을 표시 눈금까지 보낸다.", "cmd": "searchlight.feed.turn", "tool": "hand", "repeat": 5, "requires": "봉 끝이 표시 눈금에 닿을 것", "hazard": "간격을 넓게 두면 불빛이 흔들리고 봉이 두 배로 빨리 탄다." },
      { "type": "Close", "text": "장전 문을 닫는다.", "cmd": "searchlight.door.close", "tool": "hand" },
      { "type": "Fasten", "text": "걸쇠 두 개를 건다.", "cmd": "searchlight.latch.{n}.tighten", "tool": "hand", "repeat": 2 },
      { "type": "Test", "text": "탐조등 레버를 올려 켠다. 현창 너머의 불빛이 하얗고 고른지 본다.", "cmd": "device.searchlight.on" }
    ]
  },
  "proc.gauge.zero": {
    "title": "상황판 계기 영점 보정",
    "fault": "SNS-05",
    "grade": "proper",
    "bind": [ "gauge" ],
    "steps": [
      { "type": "Inspect", "text": "계기 바늘을 기준 계기에 견주어 본다. 표의 기준 계기로 잰 값과 다르면 계기가 틀어진 것이다. 유리를 손가락으로 가볍게 두드려 바늘이 뛰는지 본다." },
      { "type": "Open", "text": "계기 유리 테를 연다.", "cmd": "gauge.{gauge}.glass.open", "tool": "hand" },
      { "type": "Work", "text": "걸레로 바늘 축을 닦는다.", "cmd": "gauge.{gauge}.wipe", "tool": "rag", "requires": "유리 테를 열었을 것", "hazard": "축을 닦지 않으면 바늘이 걸려 영점을 맞출 수 없다." },
      { "type": "Work", "text": "드라이버로 계기 아래의 영점 나사를 돌려 바늘을 기준 계기의 값에 맞춘다. 한 눈금에 눈금 끝의 0.5%씩 움직인다. 시계 방향이면 바늘이 올라간다." },
      { "type": "Close", "text": "계기 유리 테를 닫는다.", "cmd": "gauge.{gauge}.glass.close", "tool": "hand" },
      { "type": "Test", "text": "유리를 두드려도 바늘이 뛰지 않는지, 기준 계기와 맞는지 다시 본다." }
    ]
  }
}

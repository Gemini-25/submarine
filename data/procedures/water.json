{
  "proc.bearing.oil": {
    "title": "펌프 베어링 기름칠",
    "fault": "WTR-02",
    "grade": "temporary",
    "steps": [
      {
        "type": "Inspect",
        "text": "펌프 전류가 평소보다 높고 펌프에서 갈리는 소리가 나는지 본다. 청진기를 펌프 몸체에 대면 거친 소리가 난다."
      },
      {
        "type": "Work",
        "text": "기름통으로 펌프 위의 기름 잔에 기름을 세 번 짜 넣는다. 펌프가 돌고 있어도 된다.",
        "cmd": "pump.oilcup.oil",
        "tool": "oil_can",
        "repeat": 3
      },
      {
        "type": "Test",
        "text": "펌프 전류가 내려가고 갈리는 소리가 작아지는지 본다. 베어링은 닳은 그대로다. 기름은 펌프가 10분쯤 돌면 다 마른다. 그 전에 베어링을 간다."
      }
    ]
  },
  "proc.bearing.replace": {
    "title": "펌프 베어링 교체",
    "fault": "WTR-02",
    "grade": "proper",
    "steps": [
      {
        "type": "Inspect",
        "text": "펌프 전류가 평소보다 높고 점점 오르는지, 펌프에서 갈리는 소리가 나는지 본다. 청진기를 펌프 몸체에 대면 거친 소리가 난다."
      },
      {
        "type": "Isolate",
        "text": "배수 회로(C3) 칼날 스위치를 내려 펌프를 멈춘다. 펌프 소리가 멎었는지 듣는다.",
        "cmd": "switch.C3.off",
        "tool": "hand",
        "requires": "없음",
        "hazard": "C3 스위치를 올린 채로 베어링을 빼거나 넣으면 손이 축에 끼인다. 넣는 순간 축이 돈다."
      },
      {
        "type": "Inspect",
        "text": "몸체가 식기를 기다린다. C3 스위치를 내리고 3분 뒤 빈손으로 펌프 몸체를 만져 본다. '손을 댈 수 없다'면 더 기다린다.",
        "cmd": "pump.body.touch",
        "tool": "hand",
        "requires": "C3 스위치를 내리고 3분 기다렸을 것",
        "hazard": "아주 뜨거운 몸체를 만지면 손을 덴다."
      },
      {
        "type": "Open",
        "text": "렌치로 베어링 뚜껑 볼트 네 개를 푼다.",
        "cmd": "pump.cap.bolt.{n}.loosen",
        "tool": "wrench",
        "repeat": 4
      },
      {
        "type": "Open",
        "text": "빈손으로 베어링 뚜껑을 연다.",
        "cmd": "pump.cap.open",
        "tool": "hand",
        "requires": "몸체가 식었을 것",
        "hazard": "몸체가 뜨거울 때 뚜껑을 열면 손을 덴다."
      },
      {
        "type": "Remove",
        "text": "닳은 베어링을 빼낸다.",
        "cmd": "pump.bearing.pull",
        "tool": "hand",
        "requires": "C3 스위치가 내려가 있을 것",
        "hazard": "끼임"
      },
      {
        "type": "Remove",
        "text": "닳은 베어링을 폐기함에 버린다.",
        "cmd": "hand.drop"
      },
      {
        "type": "Install",
        "text": "후방 예비품 사물함에서 새 펌프 베어링을 꺼낸다.",
        "cmd": "locker.take.pump_bearing"
      },
      {
        "type": "Install",
        "text": "새 베어링을 자리에 끝까지 밀어 넣는다.",
        "cmd": "pump.bearing.insert",
        "requires": "C3 스위치가 내려가 있을 것",
        "hazard": "끼임"
      },
      {
        "type": "Close",
        "text": "빈손으로 베어링 뚜껑을 닫는다.",
        "cmd": "pump.cap.close",
        "tool": "hand"
      },
      {
        "type": "Fasten",
        "text": "렌치로 볼트 네 개를 모두 조인다. 하나라도 풀려 있으면 뚜껑 둘레로 기름이 새고 베어링이 빨리 닳는다.",
        "cmd": "pump.cap.bolt.{n}.tighten",
        "tool": "wrench",
        "repeat": 4
      },
      {
        "type": "Test",
        "text": "C3 스위치를 올린다. 펌프 전류가 약 2.5A로 돌아오고 갈리는 소리가 멎는지 본다.",
        "cmd": "switch.C3.on",
        "tool": "hand"
      }
    ]
  },
  "proc.checkvalve.clean": {
    "title": "역류 방지 밸브 분해 청소",
    "fault": "WTR-03",
    "grade": "proper",
    "steps": [
      {
        "type": "Inspect",
        "text": "펌프가 돌고 전류가 약 2.5A로 정상인데 빌지 수위가 줄지 않는지 본다. 배관에서 물이 되돌아오는 꾸르륵 소리가 나고 흡입구에서 자갈 구르는 소리는 나지 않는다."
      },
      {
        "type": "Isolate",
        "text": "배수 회로(C3) 칼날 스위치를 내려 펌프를 멈춘다. 펌프 소리가 멎었는지 듣는다.",
        "cmd": "switch.C3.off",
        "tool": "hand",
        "requires": "없음",
        "hazard": "펌프가 도는 채로 보닛을 열면 펌프가 밀어 올린 물이 보닛에서 뿜어 나온다."
      },
      {
        "type": "Isolate",
        "text": "빈손으로 펌프 배출 밸브 바퀴를 시계 방향으로 세 바퀴 돌려 끝까지 잠근다.",
        "cmd": "pump.discharge.close",
        "tool": "hand",
        "repeat": 3,
        "requires": "없음",
        "hazard": "배출 밸브를 열어 둔 채 보닛을 열면 배출관의 바닷물이 뿜어 나오고, 보닛을 닫을 때까지 계속 들어온다."
      },
      {
        "type": "Open",
        "text": "렌치로 보닛 볼트 네 개를 푼다.",
        "cmd": "checkvalve.bolt.{n}.loosen",
        "tool": "wrench",
        "repeat": 4
      },
      {
        "type": "Open",
        "text": "빈손으로 보닛을 연다.",
        "cmd": "checkvalve.bonnet.open",
        "tool": "hand",
        "requires": "C3 스위치가 내려가 있고 배출 밸브가 잠겨 있을 것",
        "hazard": "물 분출"
      },
      {
        "type": "Remove",
        "text": "역지 밸브 판을 빼낸다.",
        "cmd": "checkvalve.flap.pull",
        "tool": "hand"
      },
      {
        "type": "Work",
        "text": "판을 든 채 세척통에서 솔로 세 번 문질러 경첩과 자리면의 녹과 앙금을 벗긴다.",
        "cmd": "wash_bucket.scrub",
        "tool": "scrub_brush",
        "repeat": 3
      },
      {
        "type": "Install",
        "text": "판을 제자리에 끼운다. 판이 경첩에서 손으로 가볍게 열리고 닫히는지 본다.",
        "cmd": "checkvalve.flap.insert"
      },
      {
        "type": "Close",
        "text": "빈손으로 보닛을 닫는다.",
        "cmd": "checkvalve.bonnet.close",
        "tool": "hand"
      },
      {
        "type": "Fasten",
        "text": "렌치로 보닛 볼트를 1-3-2-4 순서로 조인다. 순서를 어기면 보닛이 비뚤게 앉아 가장자리로 물이 샌다.",
        "cmd": "checkvalve.bolt.{n}.tighten",
        "tool": "wrench",
        "repeat": 4,
        "order": [
          1,
          3,
          2,
          4
        ]
      },
      {
        "type": "Install",
        "text": "빈손으로 배출 밸브 바퀴를 반시계 방향으로 세 바퀴 돌려 끝까지 연다. 잠근 채 두면 펌프가 물을 내보내지 못한다.",
        "cmd": "pump.discharge.open",
        "tool": "hand",
        "repeat": 3
      },
      {
        "type": "Test",
        "text": "C3 스위치를 올린다. 펌프 전류가 약 2.5A이고 빌지 수위가 줄며 꾸르륵 소리가 멎는지 본다. 보닛 가장자리가 말라 있는지 본다.",
        "cmd": "switch.C3.on",
        "tool": "hand"
      }
    ]
  }
}

{
  "cues": {
    "air.chlorine": { "sense": "Smell", "anchor": "mid", "q": "air.cl2", "map": [[3, 0], [10, 0.5], [30, 1]], "caption": "cue.air.chlorine" },
    "cell.{n}.fizz": { "bind": { "n": "cells" }, "sense": "Sound", "anchor": "cell.{n}", "q": "cell.{n}.temp", "map": [[30, 0], [40, 1]], "caption": "cue.cell.fizz" },
    "circuit.{c}.lamp": { "bind": { "c": "circuits" }, "sense": "Sight", "anchor": "{c}", "q": "circuit.{c}.energized", "map": [[0, 0], [1, 1]], "caption": "cue.circuit.lamp" },
    "fan.hum": { "sense": "Sound", "anchor": "vent_fan", "q": "device.vent_fan.running", "map": [[0, 0], [1, 1]], "caption": "cue.fan.hum" },
    "fuse.{c}.blackened": { "bind": { "c": "circuits" }, "sense": "Sight", "anchor": "fuse.{c}", "q": "part.fuse.{c}.prop.blown", "map": [[0, 0], [1, 1]], "caption": "cue.fuse.blackened" },
    "igniter.glow": { "sense": "Sight", "anchor": "o2_igniter", "q": "device.o2_igniter.running", "map": [[0, 0], [1, 1]], "caption": "cue.igniter.glow" },
    "junction.{c}.dew": { "bind": { "c": "circuits" }, "sense": "Sight", "anchor": "junction.{c}", "q": "circuit.{c}.moisture", "map": [[0.4, 0], [0.6, 0.5], [0.9, 1]], "caption": "cue.junction.dew" },
    "{p}.drip": { "bind": { "p": "leaks" }, "sense": "Sight", "anchor": "{p}", "q": "{p}.inflow", "map": [[0, 0], [0.01, 0.2], [0.3, 1]], "caption": "cue.leak.drip" },
    "{p}.hiss": { "bind": { "p": "leaks" }, "sense": "Sound", "anchor": "{p}", "q": "{p}.inflow", "map": [[0, 0], [0.01, 0.2], [0.3, 1]], "caption": "cue.leak.hiss" },
    "lights.glow": { "sense": "Sight", "anchor": "cabin_lights", "q": "lights.brightness", "map": [[0, 0], [1, 1]], "caption": "cue.lights.glow" },
    "pump.backflow": { "sense": "Sound", "anchor": "pump.check_valve", "q": "pump.backflow", "map": [[0, 0], [2, 1]], "caption": "cue.pump.backflow" },
    "pump.burning": { "sense": "Smell", "anchor": "bilge_pump", "q": "device.bilge_pump.overheated", "map": [[0, 0], [1, 1]], "caption": "cue.pump.burning" },
    "pump.gravel": { "sense": "Sound", "anchor": "pump.intake", "q": "part.pump.intake.prop.clog", "while": "device.bilge_pump.running", "map": [[0, 0], [1, 1]], "caption": "cue.pump.gravel" },
    "pump.grind": { "sense": "Sound", "anchor": "pump.bearing", "q": "part.pump.bearing.prop.drag", "while": "device.bilge_pump.running", "map": [[0.05, 0], [0.4, 0.6], [1, 1]], "caption": "cue.pump.grind" },
    "pump.hum": { "sense": "Sound", "anchor": "bilge_pump", "q": "device.bilge_pump.running", "map": [[0, 0], [1, 1]], "caption": "cue.pump.hum" },
    "pump.smoke": { "sense": "Sight", "anchor": "bilge_pump", "q": "device.bilge_pump.overheated", "map": [[0, 0], [1, 1]], "caption": "cue.pump.smoke" },
    "scrubber.indicator": { "sense": "Sight", "anchor": "scrubber.canister", "q": "air.canister", "while": "part.scrubber.canister.prop.present", "map": [[0, 0], [1, 1]], "caption": "cue.scrubber.indicator" }
  },
  "instruments": {
    "ammeter.{c}": { "bind": { "c": "circuits" }, "anchor": "{c}", "q": "circuit.{c}.current", "unit": "A", "label": "reading.ammeter" },
    "bilge.aft.glass": { "anchor": "bilge.aft", "q": "bilge.aft.water", "unit": "L", "label": "reading.bilge.aft" },
    "bilge.fwd.glass": { "anchor": "bilge.fwd", "q": "bilge.fwd.water", "unit": "L", "label": "reading.bilge.fwd" },
    "clock": { "anchor": "fore", "q": "time", "unit": "s", "label": "reading.clock" }
  },
  "stethoscope": {
    "fan.motor": { "q": "part.fan.motor.prop.stalled", "while": "circuit.C2.energized", "map": [[0, 0.1], [1, 0.6]] },
    "pump.body": { "q": "part.pump.bearing.prop.drag", "while": "device.bilge_pump.running", "map": [[0, 0.1], [0.4, 0.6], [1, 1]] }
  },
  "measure": {
    "hydrometer": { "sgEmpty": 1.10, "sgFull": 1.28 },
    "bridge": {
      "insulationMOhm": [[0, 100], [0.2, 30], [0.4, 10], [0.5, 5], [0.6, 2], [0.8, 1], [0.95, 0.3], [1, 0.2]],
      "cellOhm": [[0, 0.5], [0.3, 0.15], [1, 0.02]],
      "filamentOhm": 0.6
    }
  }
}

    ],
    "props": {
      "trimDeg": 0,
      "rollClock": 0
    }
  },
  "ballast.fore.valve": {
    "kind": "flood_valve",
    "visible": [
      "turned",
      "gland",
      "oil",
      "packingOut",
      "wrap"
    ],
    "props": {
      "corroded": 0,
      "freeArmed": 0,
      "freeLife": 0,
      "freePatch": 0,
      "gland": 3,
      "oil": 0,
      "open": 0,
      "packingOut": 0,
      "soakArmed": 0,
      "soakLife": 0,
      "strikes": 0,
      "stuck": 0,
      "turned": 0,
      "wrap": 0
    },
    "timers": [
      {
        "prop": "soakLife",
        "perSecond": 1,
        "armed": "soakArmed",
        "onExpire": [
          {
            "set": "stuck",
            "to": 0
          },
          {
            "set": "oil",
            "to": 0
          },
          {
            "if": "self.corroded >= 0.5 && self.freePatch < 0.5",
            "arm": "freeLife",
            "to": 600
          }
        ]
      },
      {
        "prop": "freeLife",
        "perSecond": 1,
        "armed": "freeArmed",
        "onExpire": [
          {
            "if": "self.corroded >= 0.5",
            "set": "stuck",
            "to": 1
          },
          {
            "if": "self.freePatch >= 0.5",
            "event": "TempRepairFailed"
          },
          {
            "set": "freePatch",
            "to": 0
          }
        ]
      }
    ],
    "seaPaths": [
      {
        "zone": "mid",
        "areaCm2": 0.3,
        "when": "self.gland <= 0"
      },
      {
        "zone": "mid",
        "areaCm2": 0.2,
        "when": "self.gland >= 1 && self.gland <= 2"
      }
    ]
  },

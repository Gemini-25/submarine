              "if": "self.soldered >= $strokes",
              "set": "twisted",
              "to": 0
            },
            {
              "if": "self.soldered >= $strokes",
              "set": "spliced",
              "to": 1
            }
          ]
        },
        "twist": {
          "gesture": "rotate",
          "tool": "hand",
          "rejectIf": [
            {
              "if": "self.coverOpen < 0.5",
              "reason": "cover_closed"
            },
            {
              "if": "self.burnt < 0.5",
              "reason": "done"
            },
            {
              "if": "self.stripped < $strokes",
              "reason": "twist_not_stripped"
            }
          ],
          "hazards": [
            {
              "if": "circuit.{c}.on == 1 && battery.voltage > 0 && part.fuse.{c}.prop.blown < 0.5 && part.fuse.{c}.prop.present >= 0.5",
              "hazard": "shock"
            }
          ],
          "effects": [
            {
              "set": "burnt",
              "to": 0
            },
            {
              "set": "insulated",
              "to": 0
            },
            {
              "set": "twisted",
              "to": 1
            },
            {
              "set": "spliced",
              "to": 1
            }
          ]
        },
        "wrap": {
          "gesture": "rotate",
          "tool": "hand",
          "hold": "insulating_tape",
          "noise": "wrap",
          "rejectIf": [
            {
              "if": "self.coverOpen < 0.5",
              "reason": "cover_closed"
            },
            {
              "if": "self.wrap >= $wraps",
              "reason": "done"
            }
          ],
          "hazards": [
            {
              "if": "circuit.{c}.on == 1 && battery.voltage > 0 && part.fuse.{c}.prop.blown < 0.5 && part.fuse.{c}.prop.present >= 0.5 && self.insulated < 0.5",
              "hazard": "shock"
            }
          ],
          "effects": [
            {
              "add": "wrap",
              "by": 1,
              "max": 3
            },
            {
              "if": "self.wrap >= $wraps && self.moisture > $trapAbove",
              "set": "trapped",
              "to": 1
            },
            {
              "if": "self.wrap >= $wraps",
              "set": "insulated",
              "to": 1
            },
            {
              "if": "self.wrap >= $wraps",
              "set": "taped",
              "to": 1
            },
            {
              "if": "self.wrap >= $wraps",
              "set": "stripped",
              "to": 0
            },
            {
              "if": "self.wrap >= $wraps",
              "set": "soldered",
              "to": 0
            },
            {
              "if": "self.wrap >= $wraps",
              "consume": true
            }
          ]
        }
      }
    }
  ]
}

{
  "proc.fuse.replace": {
    "title": "퓨즈 교체",
    "fault": "ELC-01",
    "grade": "proper",
    "bind": [
      "circuit"
    ],
    "steps": [
      {
        "type": "Inspect",
        "text": "상황판 배전반 표시등과 배전반의 회로 표시등(스위치가 올라가 있는데 꺼진 것)을 본다. 끊긴 퓨즈는 유리관 안의 선이 끊어져 검게 그을려 있다. 전압계를 퓨즈 양단에 대면 끊긴 퓨즈에는 전원 전압이 걸린다.",
        "tool": "voltmeter"
      },
      {
        "type": "Isolate",
        "text": "그 회로의 칼날 스위치를 내린다.",
        "cmd": "switch.{circuit}.off",
        "tool": "hand",
        "requires": "없음",
        "hazard": "스위치를 내리지 않고 퓨즈를 만지면 감전된다."
      },
      {
        "type": "Remove",
        "text": "끊긴 퓨즈를 소켓에서 뽑는다.",
        "cmd": "fuse.{circuit}.pull",
        "tool": "hand",
        "requires": "회로 스위치가 내려가 있을 것",
        "hazard": "감전 (잠시 손을 못 쓰고 몸이 상한다)"
      },
      {
        "type": "Remove",
        "text": "끊긴 퓨즈를 폐기함에 버린다.",
        "cmd": "hand.drop"
      },
      {
        "type": "Install",
        "text": "예비품 사물함에서 새 퓨즈를 꺼낸다.",
        "cmd": "locker.take.fuse"
      },
      {
        "type": "Install",
        "text": "새 퓨즈를 소켓에 끝까지 밀어 넣는다.",
        "cmd": "fuse.{circuit}.insert",
        "requires": "회로 스위치가 내려가 있을 것",
        "hazard": "살아 있는 소켓에 꽂으면 불꽃이 튀고 감전된다. 수소가 차 있으면 폭발한다."
      },
      {
        "type": "Test",
        "text": "스위치를 올리고 표시등과 장비가 살아나는지 본다. 바로 다시 끊기면 원인(누전, 과부하)이 남아 있는 것이다.",
        "cmd": "switch.{circuit}.on"
      }
    ]
  },
  "proc.strainer.clean": {
    "title": "펌프 흡입 거름망 청소",
    "fault": "WTR-01",
    "grade": "proper",
    "steps": [
      {
        "type": "Inspect",
        "text": "펌프가 도는데 배수량 계기가 0이고 펌프 전류가 평소보다 낮으면 흡입구가 막힌 것이다. 펌프 쪽에서 자갈 구르는 소리가 난다."
      },
      {
        "type": "Isolate",
        "text": "배수 회로(C3) 스위치를 내려 펌프를 멈춘다.",
        "cmd": "switch.C3.off",
        "tool": "hand",
        "hazard": "펌프가 도는 채로 바구니를 빼거나 넣으면 손이 흡입구로 끌려 들어간다."
      },
      {
        "type": "Open",
        "text": "렌치로 거름망 덮개 볼트 네 개를 푼다.",
        "cmd": "strainer.bolt.{n}.loosen",
        "tool": "wrench",
        "repeat": 4
      },
      {
        "type": "Open",
        "text": "덮개를 연다.",
        "cmd": "strainer.cover.open",
        "tool": "hand"
      },
      {
        "type": "Remove",
        "text": "거름망 바구니를 꺼낸다.",
        "cmd": "strainer.basket.remove",
        "requires": "펌프가 멈춰 있을 것",
        "hazard": "끼임"
      },
      {
        "type": "Work",
        "text": "솔로 바구니를 문질러 자갈과 부착물을 털어 낸다. 네 번 정도 문지르면 깨끗해진다.",
        "cmd": "strainer.basket.scrub",
        "tool": "scrub_brush",
        "repeat": 4
      },
      {
        "type": "Install",
        "text": "바구니를 다시 넣는다.",
        "cmd": "strainer.basket.insert",
        "tool": "hand",
        "requires": "펌프가 멈춰 있을 것",
        "hazard": "끼임"
      },
      {
        "type": "Close",
        "text": "덮개를 닫는다.",
        "cmd": "strainer.cover.close"
      },
      {
        "type": "Fasten",
        "text": "볼트 네 개를 모두 조인다. 하나라도 풀려 있으면 흡입 쪽으로 공기가 새어 배수량이 준다.",
        "cmd": "strainer.bolt.{n}.tighten",
        "tool": "wrench",
        "repeat": 4
      },
      {
        "type": "Test",
        "text": "C3 스위치를 올리고 배수량 계기가 오르는지, 빌지 수위가 내려가는지 본다.",
        "cmd": "switch.C3.on",
        "tool": "hand"
      }
    ]
  },
  "proc.rivet.wedge": {
    "title": "리벳 이음 응급 막기 (쐐기와 버팀목)",
    "fault": "HUL-01",
    "grade": "temporary",
    "bind": [
      "point"
    ],
    "steps": [
      {
        "type": "Inspect",
        "text": "구역 경고등과 쉿 소리로 새는 이음새를 찾는다. 이음새에 물줄기와 물방울이 보인다."
      },
      {
        "type": "Install",
        "text": "사물함에서 나무 쐐기를 꺼낸다.",
        "cmd": "locker.take.wood_wedge",
        "tool": "hand"
      },
      {
        "type": "Install",
        "text": "나무망치로 쐐기를 이음새에 박는다. 세 번 치면 박힌다.",
        "cmd": "{point}.wedge",
        "tool": "mallet",
        "repeat": 3,
        "hazard": "시끄럽다 (나무망치 18)"
      },
      {
        "type": "Install",
        "text": "사물함에서 버팀목을 꺼낸다.",
        "cmd": "locker.take.timber_shore",
        "tool": "hand"
      },
      {
        "type": "Install",
        "text": "버팀목으로 쐐기를 받친다. 쐐기만으로는 물이 꽤 샌다.",
        "cmd": "{point}.shore"
      },
      {
        "type": "Test",
        "text": "구역 경고등이 꺼지는지 본다. 응급 패치는 수압에 밀려 시간이 지나면 다시 샌다. 깊을수록 빨리 밀려난다."
      }
    ]
  },
  "proc.rivet.caulk": {
    "title": "리벳 이음 코킹",
    "fault": "HUL-01",
    "grade": "proper",
    "bind": [
      "point"
    ],
    "steps": [
      {
        "type": "Inspect",
        "text": "새는 이음새를 찾는다. 응급 패치가 있으면 코킹을 마칠 때 걷어 낸다."
      },
      {
        "type": "Work",
        "text": "코킹 정을 이음새에 대고 망치로 친다. 여덟 번 치면 이음새가 메워진다.",
        "cmd": "{point}.caulk",
        "tool": "caulking_set",
        "repeat": 8,
        "hazard": "매우 시끄럽다 (코킹 45)"
      },
      {
        "type": "Test",
        "text": "구역 경고등이 꺼지는지 본다. 코킹한 이음새는 오래간다."
      }
    ]
  }
}

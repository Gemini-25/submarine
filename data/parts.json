    },
    "wearFault": "AIR-01",
    "visible": [
      "guardNut1",
      "guardNut2",
      "guardOpen",
      "hubNut",
      "present"
    ],
    "timers": [
      {
        "prop": "spinLife",
        "perSecond": 1,
        "while": "device.vent_fan.running == 1",
        "armed": "spinArmed",
        "onExpire": [
          {
            "set": "stalled",
            "to": 1
          },
          {
            "event": "TempRepairFailed",
            "detail": "AIR-01"
          }
        ]
      },
      {
        "prop": "hubLife",
        "perSecond": 1,
        "while": "self.hubNut < 0.5 && device.vent_fan.running == 1",
        "armed": "hubArmed",
        "onExpire": [
          {
            "set": "stalled",
            "to": 1
          }
        ]
      }
    ]
  },

{
  "name": "AIR-03 막힌 산소 화로: 양초를 켜도 산소가 오르지 않고 문틈으로 연기가 새며, 다 탄 양초가 재를 더 쌓는다",
  "seed": 231,
  "depth": 300,
  "setup": {
    "air": {
      "o2": 18
    }
  },
  "inject": [
    {
      "tick": 0,
      "fault": "AIR-03"
    }
  ],
  "commands": [
    {
      "tick": 20,
      "cmd": "candle.light"
    }
  ],
  "expect": [
    {
      "byTick": 40,
      "assert": "inventory.candles == 3 && air.candleSeconds > 0 && cue.igniter.glow == 1",
      "note": "점화기는 살아 있어 양초에 불이 붙는다"
    },
    {
      "byTick": 400,
      "assert": "cue.furnace.smoke > 0.8 && cue.furnace.acrid > 0.9 && cue.furnace.choke > 0.7",
      "note": "문틈 연기, 매캐한 냄새, 막힌 울림"
    },
    {
      "byTick": 400,
      "assert": "measure.voltmeter.circuit.C2 > 0.9",
      "note": "C2 부하 단자에 전압이 있다: 점화기 회로가 아니다"
    },
    {
      "always": "air.o2 < 18.02 && panel.gauge.o2 < 18.02",
      "toTick": 12000,
      "note": "양초 산소가 사람의 소비만큼밖에 나오지 않는다"
    },
    {
      "byTick": 12100,
      "assert": "air.candleSeconds == 0 && cue.furnace.smoke == 0 && part.o2.furnace.prop.ash > 0.95",
      "note": "다 탄 양초가 재를 더 남긴다"
    },
    {
      "byTick": 30000,
      "assert": "panel.lamp.air == 'warning' && panel.gauge.o2 < 17.1",
      "note": "양초가 산소를 내지 못해 17% 아래로 내려가면 공기 표시등이 주의로 켜진다"
    },
    {
      "never": "panel.lamp.air == 'fault'",
      "toTick": 12100
    }
  ],
  "ordered": false
}

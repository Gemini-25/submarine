      "assert": "device.bilge_pump.current > 280 && device.bilge_pump.current < 320 && pump.grossFlow > 1.9 && pump.netFlow == 0"
    },
    {
      "byTick": 200,
      "assert": "cue.pump.backflow > 0.9 && cue.pump.gravel == 0 && cue.checkvalve.drip == 0"
    },
    {
      "byTick": 600,
      "assert": "device.bilge_pump.current > 132 && device.bilge_pump.current < 156 && pump.grossFlow == 0 && cue.pump.backflow == 0 && pump.discharge == 0"
    }
  ]

      "tick": 0,
      "fault": "WTR-03"
    }
  ],
  "commands": [
    {
      "tick": 0,
      "cmd": "switch.C3.on"
    },
    {
      "tick": 400,
      "cmd": "switch.C3.off"
    },
    {
      "tick": 420,
      "cmd": "pump.discharge.close"
    },
    {
      "tick": 440,
      "cmd": "pump.discharge.close"
    },
    {
      "tick": 460,
      "cmd": "pump.discharge.close"
    },
    {
      "tick": 480,
      "cmd": "switch.C3.on"
    }
  ],
  "expect": [

{
  "SNS-01": {
    "name": "상황판 전구 소손",
    "system": "senses",
    "partKind": "panel_bulb",
    "defaultPart": "panel.bulb.water",
    "state": "Fault",
    "set": {
      "burnt": 1
    },
    "baseRatePerHour": 0
  },
  "SNS-03": {
    "name": "청음기 진공관 소손",
    "system": "senses",
    "partKind": "vacuum_tube",
    "defaultPart": "hydrophone.tube.1",
    "state": "Fault",
    "set": {
      "filament": 0.3
    },
    "baseRatePerHour": 0
  },
  "SNS-02": {
    "name": "상황판 배선 오표시",
    "system": "senses",
    "partKind": "panel_wiring",
    "defaultPart": "panel.wiring",
    "state": "Fault",
    "set": {
      "moisture": 0.75,
      "seated": 0
    },
    "clearedWhen": "self.moisture <= 0.2 || self.seated >= 1 && self.moisture < 0.5 && self.coverOpen == 0",
    "baseRatePerHour": 0
  },
  "SNS-04": {
    "name": "탐조등 탄소봉 소모",
    "system": "senses",
    "partKind": "arc_rods",
    "defaultPart": "searchlight.rods",
    "state": "Fault",
    "set": {
      "gap": 0.75,
      "length": 0.3
    },
    "baseRatePerHour": 0
  },
  "SNS-05": {
    "name": "상황판 계기 드리프트",
    "system": "senses",
    "partKind": "panel_gauge",
    "defaultPart": "gauge.voltage",
    "state": "Fault",
    "set": {
      "offset": -0.12,
      "stick": 0.03
    },
    "clearedWhen": "self.offset > -0.01 && self.offset < 0.01 && self.stick == 0",
    "baseRatePerHour": 0
  }
}
